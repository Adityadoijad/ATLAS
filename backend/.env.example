# Copy to .env for local development. Never commit .env.

# ── Required ────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=generate-a-long-random-secret
DATABASE_URL=postgresql+psycopg://atlas_user:change-this-local-password@localhost:5432/atlas
# AI provider. Free key (no card required): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Model is configurable. Verify availability for your account with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL=openai/gpt-oss-120b

# ── Optional — each feature degrades to "data unavailable" if unset ─────────
# Weather (destination details, weather agent). Free tier: openweathermap.org
OPENWEATHER_API_KEY=optional_openweathermap_api_key
# Activities/attractions on the destination-details page. Free, no card required:
# https://opentripmap.io/product
OPENTRIPMAP_API_KEY=optional_opentripmap_api_key
# Restaurants on the destination-details page. Free tier, no card required:
# https://developer.foursquare.com
# Food/restaurant data now comes from OpenStreetMap via the Overpass API,
# which needs no key and no account. FOURSQUARE_API_KEY is no longer read by
# any code path and can be removed from your .env.
# Redis-backed rate limiting for multi-worker deployments. Falls back to
# in-process rate limiting (fine for a single-worker/local setup) if unset.
REDIS_URL=

PORT=8000
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Google OAuth (optional — "Continue with Google" is hidden if unset)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Outbound email (booking confirmation with the e-ticket attached)
# ---------------------------------------------------------------------------
# Entirely optional. Leave SMTP_HOST empty and ATLAS runs exactly as before:
# the "Email Confirmation" action is hidden and the PDF download is unaffected.
#
# Sent FROM an ATLAS mailbox, not from the traveller's account, so this works
# for password and Google users alike and does not touch the OAuth flow.
#
# For Gmail: enable 2-Step Verification, then create an App Password
# (https://myaccount.google.com/apppasswords) and use it as SMTP_PASSWORD.
# A normal account password will not work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_sender_address@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM_EMAIL=your_sender_address@gmail.com
SMTP_FROM_NAME=ATLAS Travel
# STARTTLS on port 587 (the usual case). For SSL-on-connect use port 465 with
# SMTP_USE_TLS=false and SMTP_USE_SSL=true.
SMTP_USE_TLS=true
SMTP_USE_SSL=false
